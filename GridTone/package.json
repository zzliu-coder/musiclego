{
  "name": "gridtone",
  "version": "1.3.0",
  "private": true,
  "description": "声格：可离线运行的音乐绘画编辑器，零运行时依赖。",
  "scripts": {
    "start": "node scripts/server.mjs",
    "catalog": "node scripts/catalog-build.mjs",
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/catalog-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && python3 tests/run_browser_tests.py",
    "verify": "npm test && npm run test:e2e",
    "prebuild": "node scripts/catalog-build.mjs",
    "catalog:generate": "node scripts/content-build.mjs && node scripts/catalog-build.mjs",
    "test:prism": "npm run build && python3 tests/prism_browser.py"
  }
}
